# Shared local settings
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_EMAIL=admin@example.com

# Azure Cosmos DB (leave blank for local in-memory mode)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=campusbooking

# Azure Blob Storage (leave blank for local file mode)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=event-images

# Booking service integrations
EVENT_SERVICE_URL=http://event-service:4002
CONFIRMATION_FUNCTION_URL=
